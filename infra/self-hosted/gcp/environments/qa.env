# Hebo self-hosted — QA/testing environment.
#
# DOMAIN_MODE=sslip needs no domain purchase: sslip.io resolves
# "<anything>.<ip>.sslip.io" to <ip> automatically, and Caddy still gets
# real trusted Let's Encrypt certs for it.

PROJECT_ID=cat-424007
REGION=asia-southeast1
ZONE=asia-southeast1-a
MACHINE_TYPE=e2-medium
BOOT_DISK_SIZE=20GB
DATA_DISK_SIZE=50GB

DOMAIN_MODE=sslip
