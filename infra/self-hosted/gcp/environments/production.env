# Hebo self-hosted — production environment.
#
# Fill in PROJECT_ID and BASE_DOMAIN before running deploy.sh — it refuses
# to run against the placeholder values below.
#
# DOMAIN_MODE=custom builds console./api./gateway./auth./mcp.<BASE_DOMAIN>.
# deploy.sh will print the A records to create and pause until you confirm
# they're in place (Let's Encrypt needs them resolving before it can issue
# certs).

PROJECT_ID=CHANGE_ME
REGION=us-central1
ZONE=us-central1-a
MACHINE_TYPE=e2-standard-2
BOOT_DISK_SIZE=30GB
DATA_DISK_SIZE=100GB

DOMAIN_MODE=custom
BASE_DOMAIN=hebo.yourdomain.com
