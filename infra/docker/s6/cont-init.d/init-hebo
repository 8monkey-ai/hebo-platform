#!/command/with-contenv sh
set -e

# init-hebo — oneshot bootstrap (runs before any longrun services)
#
# Standalone mode: run Prisma migrations
# ECS single-role modes: skip (Lambda migrator handles DB, SST handles secrets)

HEBO_MODE="${HEBO_MODE:-standalone}"

if [ "$HEBO_MODE" != "standalone" ]; then
  echo "[init] Skipping bootstrap (HEBO_MODE=${HEBO_MODE}, managed by SST)"
  exit 0
fi

# ── Resolve schema names ──
# Auth defaults to `hebo_auth` (Supabase reserves `auth`). Installs that already
# applied migrations to the legacy `auth` schema keep using it. Connection errors
# abort the bootstrap rather than silently picking a fresh schema.
if [ -z "$POSTGRES_AUTH_SCHEMA" ]; then
  POSTGRES_AUTH_SCHEMA=$(bun -e '
    const sql = new Bun.SQL(process.env.POSTGRES_URL);
    const [{ found }] = await sql`SELECT to_regclass(${"auth._prisma_migrations"}) IS NOT NULL AS found`;
    const legacy = found && (await sql`SELECT 1 FROM auth._prisma_migrations WHERE finished_at IS NOT NULL LIMIT 1`).length > 0;
    console.log(legacy ? "auth" : "hebo_auth");
    await sql.close();
  ')
fi

API_SCHEMA=$(printf '%s' "${POSTGRES_API_SCHEMA:-api}" | tr '[:upper:]' '[:lower:]')
AUTH_SCHEMA=$(printf '%s' "$POSTGRES_AUTH_SCHEMA" | tr '[:upper:]' '[:lower:]')

# S6_KEEP_ENV=1 makes the container environment read-only, so hand the resolved
# schema to the auth service through a file it sources on start.
mkdir -p /run/hebo
printf 'export POSTGRES_AUTH_SCHEMA=%s\n' "$AUTH_SCHEMA" > /run/hebo/env

# ── Run Prisma migrations ──
case "$POSTGRES_URL" in
  *\?*) SEP="&" ;;
  *) SEP="?" ;;
esac

echo "[init] Running API schema migrations (schema=${API_SCHEMA})"
POSTGRES_URL="${POSTGRES_URL}${SEP}schema=${API_SCHEMA}" \
  bunx --bun prisma migrate deploy --config /app/prisma/api/prisma.config.ts

echo "[init] Running Auth schema migrations (schema=${AUTH_SCHEMA})"
POSTGRES_URL="${POSTGRES_URL}${SEP}schema=${AUTH_SCHEMA}" \
  bunx --bun prisma migrate deploy --config /app/prisma/auth/prisma.config.ts

echo "[init] Bootstrap complete"
