#!/command/with-contenv sh
set -e

# init-hebo — oneshot bootstrap (runs before any longrun services)
#
# Standalone mode: run Prisma migrations
# ECS single-role modes: skip (Lambda migrator handles DB, SST handles secrets)

HEBO_MODE="${HEBO_MODE:-standalone}"

if [ "$HEBO_MODE" != "standalone" ]; then
  echo "[init] Skipping bootstrap (HEBO_MODE=${HEBO_MODE}, managed by SST)"
  exit 0
fi

# ── Resolve auth schema ──
# New installs use `hebo_auth` (Supabase reserves `auth`); installs that already
# have Hebo tables in `auth` keep it. Saved to a file because S6_KEEP_ENV=1.
if [ -z "$POSTGRES_AUTH_SCHEMA" ]; then
  POSTGRES_AUTH_SCHEMA=$(bun -e 'const [r] = await Bun.sql`SELECT to_regclass(${"auth.organizations"}) IS NOT NULL AS legacy`; console.log(r.legacy ? "auth" : "hebo_auth"); process.exit()')
fi
mkdir -p /run/hebo
echo "export POSTGRES_AUTH_SCHEMA=$POSTGRES_AUTH_SCHEMA" > /run/hebo/env

# ── Run Prisma migrations ──
case "$POSTGRES_URL" in *\?*) SEP="&" ;; *) SEP="?" ;; esac

echo "[init] Running API schema migrations"
POSTGRES_URL="${POSTGRES_URL}${SEP}schema=api" \
  bunx --bun prisma migrate deploy --config /app/prisma/api/prisma.config.ts

echo "[init] Running Auth schema migrations (schema=${POSTGRES_AUTH_SCHEMA})"
POSTGRES_URL="${POSTGRES_URL}${SEP}schema=${POSTGRES_AUTH_SCHEMA}" \
  bunx --bun prisma migrate deploy --config /app/prisma/auth/prisma.config.ts

echo "[init] Bootstrap complete"
