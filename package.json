{
  "name": "hebo",
  "version": "0.8.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --workspaces --if-present --sequential build",
    "clean": "git clean -fdx -e '.env*'",
    "db:migrate": "bun run --workspaces --if-present --sequential db:migrate",
    "db:reset": "bun run --workspaces --if-present --sequential db:reset",
    "predev": "bun run --workspaces --if-present --sequential predev",
    "dev": "bun run --workspaces --if-present --parallel dev",
    "dev:infra:up": "docker compose -f infra/dev/docker-compose.yaml up -d",
    "dev:infra:down": "docker compose -f infra/dev/docker-compose.yaml down",
    "format": "oxfmt .",
    "format:staged": "oxfmt --no-error-on-unmatched-pattern",
    "lint": "oxlint",
    "lint:staged": "oxlint --fix --no-error-on-unmatched-pattern",
    "lint:deps": "check-dependency-version-consistency .",
    "prepare": "test -n \"$CI\" || lefthook install",
    "secret": "bun run scripts/secrets.ts",
    "test": "bun run --workspaces --if-present --parallel test",
    "pretypecheck": "bun run predev",
    "typecheck": "bun run --workspaces --if-present --parallel typecheck"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "check-dependency-version-consistency": "^6.0.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sst": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "@opentelemetry/api": "1.9.1"
  },
  "engines": {
    "bun": "^1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "ai": "^7.0.150",
    "@8monkey/opentelemetry-instrumentation-bun-sql": "^0.2.0",
    "@ai-sdk/provider-utils": "^5.0.67",
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "^1.7.12",
    "auth": "^1.7.12",
    "@conform-to/react": "^1.21.2",
    "@conform-to/zod": "^1.21.2",
    "@elysia/cors": "^1.4.2",
    "@elysia/eden": "^1.4.10",
    "@elysia/openapi": "^1.4.16",
    "@elysia/opentelemetry": "^1.4.12",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.217.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.217.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.217.0",
    "@opentelemetry/instrumentation": "^0.217.0",
    "@opentelemetry/instrumentation-pg": "^0.69.0",
    "@opentelemetry/otlp-exporter-base": "^0.217.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@better-auth/prisma-adapter": "^1.7.12",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.4.30",
    "lucide-react": "^1.61.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "@react-router/dev": "^8.5.0",
    "@react-router/fs-routes": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "sst": "^4.17.2",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  }
}
