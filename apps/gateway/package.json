{
  "name": "@hebo/gateway",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun build src/index.ts --minify-whitespace --minify-syntax --keep-names --target=bun --outdir dist $([ \"$NODE_ENV\" = production ] && echo '--production')",
    "clean": "git clean -fdx -e '.env*' .",
    "dev": "bun --hot src/index.ts",
    "format": "oxfmt .",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "oxlint --type-aware --type-check",
    "prestart": "bun run build",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.25",
    "@ai-sdk/amazon-bedrock": "^5.0.43",
    "@ai-sdk/anthropic": "^4.0.30",
    "@ai-sdk/azure": "^4.0.31",
    "@ai-sdk/deepinfra": "^3.0.23",
    "@ai-sdk/deepseek": "^3.0.22",
    "@ai-sdk/fireworks": "^3.0.25",
    "@ai-sdk/google-vertex": "^5.0.41",
    "@ai-sdk/groq": "^4.0.22",
    "@ai-sdk/moonshotai": "^3.0.26",
    "@ai-sdk/openai": "^4.0.30",
    "@ai-sdk/openai-compatible": "^3.0.23",
    "@ai-sdk/provider": "^4.0.5",
    "@ai-sdk/togetherai": "^3.0.24",
    "@ai-sdk/xai": "^4.0.28",
    "@aws-sdk/client-bedrock": "^3.1045.0",
    "@aws-sdk/credential-providers": "^3.1045.0",
    "@elysia/cors": "catalog:",
    "@elysia/openapi": "catalog:",
    "@elysia/opentelemetry": "catalog:",
    "@hebo-ai/gateway": "0.12.2",
    "@hebo/api": "workspace:*",
    "@hebo/shared-api": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "elysia": "catalog:",
    "lru-cache": "catalog:",
    "voyage-ai-provider": "^4.0.0",
    "zhipu-ai-provider": "^0.4.0"
  },
  "devDependencies": {
    "@hebo/typescript-config": "workspace:*",
    "@types/bun": "catalog:"
  }
}
