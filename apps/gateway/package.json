{
  "name": "@hebo/gateway",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun build src/index.ts --minify-whitespace --minify-syntax --keep-names --target=bun --outdir dist $([ \"$NODE_ENV\" = production ] && echo '--production')",
    "clean": "git clean -fdx -e '.env*' .",
    "dev": "bun --hot src/index.ts",
    "format": "oxfmt .",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "oxlint --type-aware --type-check",
    "prestart": "bun run build",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.75",
    "@ai-sdk/amazon-bedrock": "^5.0.123",
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/azure": "^4.0.109",
    "@ai-sdk/deepinfra": "^3.0.77",
    "@ai-sdk/deepseek": "^3.0.72",
    "@ai-sdk/fireworks": "^3.0.80",
    "@ai-sdk/google-vertex": "^5.0.121",
    "@ai-sdk/groq": "^4.0.69",
    "@ai-sdk/moonshotai": "^3.0.76",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@ai-sdk/provider": "^4.0.33",
    "@ai-sdk/togetherai": "^3.0.78",
    "@ai-sdk/xai": "^5.0.29",
    "@aws-sdk/client-bedrock": "^3.1156.0",
    "@aws-sdk/credential-providers": "^3.1156.0",
    "@elysia/cors": "catalog:",
    "@elysia/openapi": "catalog:",
    "@elysia/opentelemetry": "catalog:",
    "@hebo-ai/gateway": "0.13.3",
    "@hebo/api": "workspace:*",
    "@hebo/shared-api": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "elysia": "catalog:",
    "google-auth-library": "^10.9.1",
    "lru-cache": "catalog:",
    "voyage-ai-provider": "^5.0.0",
    "zhipu-ai-provider": "^0.4.0"
  },
  "devDependencies": {
    "@hebo/typescript-config": "workspace:*",
    "@types/bun": "catalog:"
  }
}
