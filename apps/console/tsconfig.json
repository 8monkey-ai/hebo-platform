{
  "extends": "@hebo/typescript-config/base.json",
  "compilerOptions": {
    "paths": {
      "~console/*": ["./app/*"],
      "~api": ["../api/src/index.ts"],
      "~api/*": ["../api/src/*"],
      "~auth/*": ["../auth/src/*"],
      "~gateway": ["../gateway/src/index.ts"],
      "~gateway/*": ["../gateway/src/*"]
    },
    "rootDirs": [".", "./.react-router/types"],
    "types": ["vite/client", "mdx"]
  },
  "include": [
    "**/*",
    "app/**/*.mdx",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ]
}
